WinuxCmd - Windows Compatible Linux Command Set
Usage: winuxcmd <command> [options]...

Available Commands:
  base32       base32 [OPTION]... [FILE]
  sha384sum    sha384sum [OPTION]... [FILE]...
  comm         comm [OPTION]... FILE1 FILE2
  arch         arch
  touch        touch [OPTION]... FILE...
  fmt          fmt [OPTION]... [FILE]...
  b2sum        b2sum [OPTION]... [FILE]...
  false        false
  dircolors    dircolors [OPTION]... [FILE]
  [            [ expression
  find         find [path...] [expression]
  diff         diff [OPTION]... FILES
  base64       base64 [OPTION]... [FILE]
  basenc       basenc ENCODING [OPTION]... [FILE]
  free         free [OPTION]
  basename     basename NAME [SUFFIX]
               basename OPTION... NAME...
  sha1sum      sha1sum [OPTION]... [FILE]...
  infocmp      infocmp [TERMNAME]
  cat          concatenate files and print on the standard output
  cal          cal [OPTION] [[MONTH] YEAR]
  wpm          manage WinuxCmd packages and command links
  groups       groups [OPTION]... [USERNAME]...
  chattr       chattr [-RVf] MODE FILE...
  d2u          d2u [OPTION]... [FILE]...
  du           estimate file space usage
  chcon        chcon [OPTION]... CONTEXT FILE...
                 or:  chcon [OPTION]... [-u USER] [-r ROLE] [-l RANGE] [-t TYPE] FILE...
                 or:  chcon [OPTION]... --reference=RFILE FILE...
  col          col [OPTION]...
  chgrp        chgrp [OPTION]... GROUP FILE...
  chmod        change file mode bits
  csplit       csplit [OPTION]... FILE PATTERN...
  chown        change file owner and group
  chroot       chroot [OPTION] NEWROOT [COMMAND [ARG]...]
  cksum        cksum [OPTION]... [FILE]...
  hostid       hostid [OPTION]
  clear        clear
  column       column [options] [file...]
  tic          tic [-e names] [-o dir] [-R name] [-v[n]] [-V] [-w[n]] [-1aCDcfGgIKLNrsTtUx] source-file
  cmp          cmp [OPTION]... FILE1 [FILE2 [SKIP1 [SKIP2]]]
  u2d          u2d [OPTION]... [FILE]...
  factor       factor [OPTION]... [NUMBER]...
  cp           copy files and directories
  cpio         cpio [OPTION]
  file         determine file type
  cut          cut OPTION... [FILE]...
  expand       expand [OPTION]... [FILE]...
  cygpath      cygpath [OPTION] NAME...
  date         print or set the system date and time
  join         join [OPTION]... FILE1 FILE2
  getconf      getconf [OPTION]... [VARIABLE_NAME]...
               getconf [OPTION]... PATH_VAR PATH
  dd           dd [OPTION]...
  df           report file system disk space usage
  diff3        diff3 [OPTION] MINE OLDER YOURS
  getopt       getopt <optstring> <parameters>
  env          env [OPTION]... [NAME=VALUE]... [COMMAND [ARG]...]
  dir          dir [OPTION]... [FILE]...
  who          who [OPTION]... [ FILE | ARG1 ARG2 ]
  dirname      dirname [OPTION] NAME...
  hmac256      hmac256 [KEY] [FILE]
  dos2unix     dos2unix [OPTION]... [FILE]...
  echo         echo [-neE] [arg ...]
  grep         grep [OPTION]... PATTERNS [FILE]...
  envsubst     envsubst [OPTION] [SHELL-FORMAT]
  expr         expr EXPRESSION
  pathchk      pathchk [OPTION] NAME...
  fold         fold [OPTION]... [FILE]...
  getfacl      getfacl [OPTION]... FILE...
  egrep        egrep [OPTION]... PATTERNS [FILE]...
  install      install [OPTION]... [-T] SOURCE DEST
                 install [OPTION]... SOURCE... DIRECTORY
                 install [OPTION]... -t DIRECTORY SOURCE...
  tput         tput [CAPNAME]
  mkgroup      mkgroup [OPTION]...
  id           id [OPTION]... [USER]
  fgrep        fgrep [OPTION]... PATTERNS [FILE]...
  head         head [OPTION]... [FILE]...
  hexdump      hexdump [OPTION]... [FILE]...
  hostname     hostname [OPTION]...
  sdiff        sdiff [OPTION] FILE1 FILE2
  kill         send a signal to a process
  killall      killall [OPTION]... NAME...
  ldd          ldd [OPTION]... FILE...
  less         less [OPTION]... [FILE]...
  ln           make links between files
  truncate     truncate OPTION... FILE...
  locale       locale [OPTION]
  locate       locate [OPTION]... PATTERN...
  logger       logger [OPTION]... [MESSAGE]
  logname      logname
  look         look [OPTION]... STRING [FILE]
  ls           list directory contents
  lsattr       lsattr [-RVadl] [FILE]...
  lsof         lsof [options]
  man          man [OPTION]... [COMMAND]...
  md5sum       md5sum [OPTION]... [FILE]...
  mkdir        make directories
  users        users [OPTION]...
  uname        uname [OPTION]...
  mkfifo       mkfifo [OPTION]... NAME...
  od           od [OPTION]... [FILE]...
  mknod        mknod [OPTION]... NAME TYPE [MAJOR MINOR]
  mkpasswd     mkpasswd [-c] [-l] [-p PREFIX] [-s SHELL] [-P FD] [-S METHOD]
  mktemp       mktemp [OPTION]... [TEMPLATE]
  more         more [OPTION]... [FILE]...
  mpicalc      mpicalc [options]
  mv           move (rename) files
  namei        namei [OPTION]... PATH...
  nice         nice [OPTION] [COMMAND [ARG]...]
  nl           nl [OPTION]... [FILE]...
  nohup        nohup COMMAND [ARG]...
  nproc        nproc [OPTION]...
  numfmt       numfmt [OPTION]... [NUMBER]...
  paste        paste [OPTION]... [FILE]...
  patch        patch [OPTION]... [ORIGFILE [PATCHFILE]]
  pgrep        pgrep [OPTION]... PATTERN
  pidof        pidof [OPTION]... PROGRAM...
  pinky        pinky [OPTION]... [USER]...
  tac          tac [OPTION]... [FILE]...
  pkill        pkill [OPTION]... PATTERN
  pldd         pldd [OPTION]... PID
  pr           pr [OPTION]... [FILE]...
  printenv     printenv [OPTION]... [VARIABLE]...
  printf       printf FORMAT [ARGUMENT]...
  ps           ps [options]
  ptx          ptx [OPTION]... [FILE]...
  pwd          print name of current/working directory
  readlink     readlink [OPTION]... FILE...
  sha512sum    sha512sum [OPTION]... [FILE]...
  realpath     print the resolved absolute path
  regtool      regtool ACTION KEY [VALUE] [DATA]
  renice       renice [-n] PRIORITY [-p] PID...  # also: -g PGRP, -u USER [DIFFERS]
  reset        reset [options] [terminal]
  rev          rev [OPTION] [FILE]...
  sum          sum [OPTION]... [FILE]...
  rm           remove files or directories
  rmdir        rmdir [OPTION]... DIRECTORY...
  runcon       runcon CONTEXT COMMAND [ARG]...
                 or:  runcon [-c] [-u USER] [-r ROLE] [-t TYPE] [-l RANGE] [COMMAND [ARG]...]
  sed          sed [OPTION]... {script} [FILE]...
  seq          seq [OPTION]... LAST
               seq [OPTION]... FIRST LAST
               seq [OPTION]... FIRST INCREMENT LAST
  vmstat       vmstat [OPTION]...
  sha224sum    sha224sum [OPTION]... [FILE]...
  sha256sum    sha256sum [OPTION]... [FILE]...
  tree         list contents of directories in a tree-like format
  shred        shred [OPTION]... FILE...
  shuf         shuf [OPTION]... [FILE]
  sleep        sleep NUMBER[SUFFIX]...
  sort         sort [OPTION]... [FILE]...
  split        split [OPTION]... [INPUT [PREFIX]]
  stat         stat [OPTION]... FILE...
  stdbuf       stdbuf [OPTION]... COMMAND [ARG]...
  strings      strings [OPTION]... [FILE]...
  stty         stty [-a|--all] [-g|--save] [SETTING...]
  sync         sync [OPTION]... [FILE]...
  tr           tr [OPTION]... SET1 [SET2]
  tail         tail [OPTION]... [FILE]...
  tee          read from standard input and write to standard output and files
  test         test [EXPRESSION]
  time         time [OPTION]... COMMAND [ARG]...
  timeout      timeout [OPTION] DURATION COMMAND [ARG]...
  toe          toe [-ahsuUV] [-v n] [file...]
  top          display Linux processes
  true         true
  tsort        tsort [FILE]
  tty          tty [OPTION]...
  tzset        tzset [OPTION]
  unexpand     unexpand [OPTION]... [FILE]...
  uniq         uniq [OPTION]... [INPUT [OUTPUT]]
  unix2dos     unix2dos [OPTION]... [FILE]...
  unlink       unlink FILE
  updatedb     updatedb [OPTION]...
  uptime       uptime [OPTION]...
  vdir         vdir [OPTION]... [FILE]...
  w            w [OPTION]...
  watch        watch [OPTION]... COMMAND
  wc           wc [OPTION]... [FILE]...
  whereis      whereis [OPTION]... NAME...
  which        which [OPTION]... COMMAND...
  whoami       whoami [OPTION]
  xargs        build and execute command lines from standard input
  xxd          xxd [OPTION]... [FILE]...
  yes          yes [STRING]...

Tip: Use 'winuxcmd <command> --help' for command-specific help.
